//	Fastfetch configuration
//
//	Reference: https://forum.endeavouros.com/t/fastfetch-config-tinkering/60919/79
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "auto",
		"source": "~/.config/fastfetch/arch-legacy-wombat-logo.png",
		"width": 32,
		"padding": {
			"left": 5
		}
	},
	"display": {
		"separator": " "
	},
	"modules": [
		{
			"key": "╭─────────────────────╮",
			"type": "custom"
		},
		{
			"key": "│ {#33}󰇅  Machine          {#keys}│",
			"type": "host"
		},
		{
			"key": "│ {#33}  Board            {#keys}│",
			"type": "board"
		},
		{
			"key": "│ {#33}  Bios             {#keys}│",
			"type": "bios"
		},
		{
			"key": "│ {#33}  Terminal         {#keys}│",
			"type": "terminal"
		},
		{
			"key": "│ {#33}  Terminal Font    {#keys}│",
			"type": "terminalfont"
		},
		{
			"key": "│ {#33}  Shell            {#keys}│",
			"type": "shell"
		},
		{
			"key": "│ {#33}󰍛  CPU              {#keys}│",
			"type": "cpu",
			"showPeCoreCount": true
		},
		{
			"key": "│ {#33}󰍛  GPU              {#keys}│",
			"type": "gpu"
		},
		{
			"key": "│ {#33}󰍛  Vulkan           {#keys}│",
			"type": "vulkan"
		},
		{
			"key": "├─────────────────────┤",
			"type": "custom"
		},
		{
			"key": "│ {#33}󰉉  Root             {#keys}│",
			"type": "disk",
			"folders": "/"
		},
		{
			"key": "│ {#33}󰟶  Memory           {#keys}│",
			"type": "memory"
		},
		{
			"key": "│ {#33}󰣁  Swap             {#keys}│",
			"type": "swap"
		},
		{
			"key": "├─────────────────────┤",
			"type": "custom"
		},
		{
			"key": "│ {#31}  Distro           {#keys}│",
			"type": "os"
		},
		{
			"key": "│ {#34}  Window Manager   {#keys}│",
			"type": "wm"
		},
		{
			"key": "│ {#33}󰍂  Display Manager  {#keys}│",
			"type": "lm"
		},
		{
			"key": "│ {#33}  Kernel           {#keys}│",
			"type": "kernel"
		},
		{
			"key": "│ {#33}󰏖  Packages         {#keys}│",
			"type": "packages"
		},
		{
			"key": "╰─────────────────────╯",
			"type": "custom"
		}
	]
}
