# Umbriel starting configuration
#
# Copy this file to ~/.config/umbriel/config.toml. Most changes apply when the
# file is saved. Check edits with `umbriel config validate`.
#
# Complete reference: https://docs.noctalia.dev/umbriel/
#
# Commented settings below are examples, not built-in defaults.

# ==============================================================================
# Includes

# Optional split configuration
# https://docs.noctalia.dev/umbriel/configuration/#include
[include]
files = []

[include.optional]
files = []

# ==============================================================================
# General
# Optional session examples. XWayland support is enabled by default.
# https://docs.noctalia.dev/umbriel/configuration/#general
#
[general]
autostart = ["noctalia", "syncthing serve --no-browser", "/usr/local/libexec/file_manager_dbus"]
# xwayland = false
# Sharp X11 apps and games on scaled outputs; they see physical resolutions.
# xwayland_native_resolution = true
# Umbriel announces the X11 interface scale and cursor theme through XSETTINGS.
# Turn this off to run your own manager, such as xsettingsd.
# xwayland_xsettings = false
# Select the monitor X11 games use as primary, using a connector or monitor identity from `umbriel outputs`.
# xwayland_primary_output = "your-output"
# NVIDIA outputs without explicit synchronization wait for GPU rendering by default.
# Disable this workaround if it causes stuttering or frame drops.
# nvidia_sync_workaround = false
# Modal dialogs hang on their parent window and follow it. Turn this off to keep them ordinary windows.
# attach_modal_dialogs = false

# ==============================================================================
# Lid events
# Remove the laptop panel from the desktop while the lid is closed, then
# restore it when the lid opens. Replace eDP-1 with the name from
# `umbriel outputs`.
# https://docs.noctalia.dev/umbriel/configuration/#events
#
# [events]
# lid_close = "umbriel msg output-disable eDP-1"
# lid_open = "umbriel msg output-enable eDP-1"

# ==============================================================================
# Screencast
# By default, the first target-changing action during an active share asks for
# confirmation. Disable that protection only if immediate keybind changes are
# preferred.
# https://docs.noctalia.dev/umbriel/configuration/#screencast
#
# [screencast]
# disable_dynamic_confirmation = true

# ==============================================================================
# Outputs
# Outputs are machine-specific. Run `umbriel outputs` to find names and modes.
# https://docs.noctalia.dev/umbriel/outputs/
#
# ==============================================================================
# Appearance
# Blur uses a smaller radius than the built-in default.
# https://docs.noctalia.dev/umbriel/appearance/
#
[appearance.blur]
radius = 3

[appearance]
corner_radius = 20

# Optional title bar with modifier-free dragging and floating frame resizing.
# [appearance.title_bar]
# mode = "on" # Follow client decoration preferences.
# Use "negotiated" to hide bars on Wayland windows that do not negotiate decorations.
# Use "forced" to always show bars, or "off" to hide them. Window rules can override this.
# height = 28
# font = "sans 10"
# button_position = "right" # or "left"
# buttons = ["minimize", "maximize", "close"] # From the title outward; leave one out to hide it.
# button_corner_radius = -1 # Follow the window's corner_radius; 0 makes square buttons.
# button_glyph = "hover" # X, square, and underscore symbols: "always", "hover" (while hovered or pressed), or "never".
# button_background = true # Show colored backgrounds behind the symbols.

# Optional button palette. Glyph colors also apply when button backgrounds are off.
# [colors.title_bar]
# close = "#FF6B6BFF"
# close_glyph = "#141419FF"
# close_glyph_hover = "#141419FF"
# maximize = "#7AA3FFFF"
# maximize_glyph = "#141419FF"
# maximize_glyph_hover = "#141419FF"
# minimize = "#FFD166FF"
# minimize_glyph = "#141419FF"
# minimize_glyph_hover = "#141419FF"

# Choose the background color shown if the lock screen takes too long to appear.
# [colors]
# backdrop = "#000000FF"

# ==============================================================================
# Effects
# Every effect is off until a preset is selected; border and window effects
# scale with overview zoom. Include a bundled preset (adjust /usr for the
# package prefix), then select it by name.
# https://docs.noctalia.dev/umbriel/effects/
#
# [include]
# files = ["/usr/share/umbriel/effects/border/pulse/effect.toml"]
# For a cursor tail, include /usr/share/umbriel/effects/cursor/trail/effect.toml
# and set cursor = "trail" in [effects].
# For audio-reactive borders, include /usr/share/umbriel/effects/border/audio/effect.toml
# and set border = "audio" in [effects].
# Enable Noctalia's Umbriel audio provider in its shell settings, or supply an
# external effect-audio v2 producer with 64 spectrum bands. Umbriel does not capture audio.
# Pools accept matching presets defined/included separately. This one-member
# example uses the bundled pulse preset; add other border names to choose.
#
# [effects.pool.borders]
# kind = "border"
# choose = ["pulse"]
# selection = "unused_first" # or round_robin, random
# Select with border = "borders" in your [effects] table.
# Add to your existing [keybinds] table:
# "Mod+Shift+E" = "effect-border-cycle borders"
# "Mod+Ctrl+E" = "effect-border-toggle"
# "Mod+Alt+E" = "effect-border-reset"
#
# [effects]
# border = "pulse"

# ==============================================================================
# Input
# Enable NumLock for the first physical keyboard; later devices inherit current locks.
# https://docs.noctalia.dev/umbriel/input/
#
# [input]
#
[input.keyboard]
numlock_toggle = true

[input.mouse]
accel_profile = "flat"
#sensitivity = -0.5

# Focus can follow the pointer across tiled, floating, and pinned windows.
#
[input.focus]
follows_mouse = true
# hover_raises = false # Hover focuses only; clicks and keybinds raise.

# Confine touch input to one display.
#
# [input.touch]
# enabled = true
# map_to_output = "eDP-1"

# ==============================================================================
# Keybinds
# Defining this table replaces the built-in bind set, so every active bind that
# should remain available is listed here.
# Syntax: https://docs.noctalia.dev/umbriel/keybinds/
# Actions: https://docs.noctalia.dev/umbriel/actions/
[keybinds]

# Applications and session
"Mod+Shift+Plus" = "cheatsheet-toggle"
"Mod+Shift+Escape" = { action = "spawn umbriel msg shortcuts-inhibit-toggle && notify-send -t 3000 \"Toggle\" \"Inhibit focused surface\"", allow_when_inhibited = true, repeat = false }
"Mod+Shift+Q" = { action = "window-close", repeat = false }

"Mod+D" = "spawn noctalia msg panel-toggle launcher"
"Mod+Shift+W" = "spawn noctalia msg panel-toggle wallpaper"
"Mod+Ctrl+Shift+W" = "spawn noctalia msg panel-toggle noctalia/wallhaven:browser"
"Mod+S" = "spawn noctalia msg panel-toggle control-center"
"Mod+A" = "spawn noctalia msg panel-toggle control-center audio"
"Mod+N" = "spawn noctalia msg settings-toggle"
"Mod+B" = "spawn noctalia msg bar-toggle"
"Mod+Shift+B" = "spawn noctalia msg dock-toggle && notify-send -t 1100 'Toggle' 'Noctalia Dock'"
"Mod+E" = "spawn noctalia msg panel-toggle launcher /emo"
"Mod+bar" = "spawn noctalia msg panel-toggle session"
"Mod+V" = "spawn noctalia msg panel-toggle clipboard"
"Mod+Shift+S" = "spawn noctalia msg screenshot-region"
"Mod+Ctrl+S" = "spawn noctalia msg screenshot-window"
"Mod+Ctrl+Shift+S" = "spawn noctalia msg screenshot-fullscreen"
"Print" = "spawn noctalia msg screenshot-fullscreen all"

"Mod+Return" = { action = "spawn alacritty", repeat = false }
"Mod+Ctrl+Return" = { action = "spawn kitty", repeat = false }
"Mod+Alt+N" = { action = "spawn kitty nvim", repeat = false }
"Mod+Alt+Y" = { action = "spawn kitty yazi", repeat = false }
"Mod+Ctrl+Alt+N" = { action = "spawn nautilus", repeat = false }
"Mod+Alt+F" = { action = "spawn firefox", repeat = false }
"Mod+Alt+D" = { action = "spawn vesktop", repeat = false }
"Mod+Alt+O" = { action = "spawn obsidian", repeat = false }
"Mod+Ctrl+Alt+Y" = { action = "spawn pear-desktop", repeat = false }

"Mod+Shift+C" = { action = "spawn COLOR=$(hyprpicker) && [ -n \"$COLOR\" ] && echo -n \"$COLOR\" | wl-copy && notify-send \"Color Picker\" \"Copied $COLOR to clipboard\"", repeat = false }
"Mod+Shift+T" = { action = "spawn ~/.local/bin/screen-ocr.sh", repeat = false }
"Mod+Shift+A" = { action = "spawn ~/.local/bin/wayscriber-toggle", repeat = false }

# Media, volume and brightness keys from any input device, routed through the
# Noctalia shell so its OSDs show. Safe while the session is locked.
# https://docs.noctalia.dev/noctalia/compositor-settings/umbriel
"XF86AudioRaiseVolume" = { action = "spawn noctalia msg volume-up", allow_when_locked = true }
"XF86AudioLowerVolume" = { action = "spawn noctalia msg volume-down", allow_when_locked = true }
"XF86AudioMute" = { action = "spawn noctalia msg volume-mute", allow_when_locked = true, repeat = false }
"XF86AudioPlay" = { action = "spawn noctalia msg media toggle", allow_when_locked = true, repeat = false }
"XF86AudioNext" = { action = "spawn noctalia msg media next", allow_when_locked = true }
"XF86AudioPrev" = { action = "spawn noctalia msg media previous", allow_when_locked = true }
"XF86MonBrightnessUp" = { action = "spawn noctalia msg brightness-up", allow_when_locked = true }
"XF86MonBrightnessDown" = { action = "spawn noctalia msg brightness-down", allow_when_locked = true }

"Mod+XF86AudioRaiseVolume" = { action = "spawn playerctl volume 0.02+", allow_when_locked = true }
"Mod+XF86AudioLowerVolume" = { action = "spawn playerctl volume 0.02-", allow_when_locked = true }

# Focus and movement
"Mod+Left" = "window-focus-left"
"Mod+Down" = "window-focus-down"
"Mod+Up" = "window-focus-up"
"Mod+Right" = "window-focus-right"
"Mod+H" = "window-focus-left"
"Mod+J" = "window-focus-down"
"Mod+K" = "window-focus-up"
"Mod+L" = "window-focus-right"
"Mod+MouseBack" = "spawn umbriel msg window-focus-left && umbriel msg column-center"
"Mod+MouseForward" = "spawn umbriel msg window-focus-right && umbriel msg column-center"
"Mod+F1" = "window-focus-next"
"Mod+Shift+Left" = "column-move-left"
"Mod+Shift+MouseBack" = "column-move-left"
"Mod+Shift+Down" = "window-move-down"
"Mod+Shift+Up" = "window-move-up"
"Mod+Shift+Right" = "column-move-right"
"Mod+Shift+MouseForward" = "column-move-right"
"Mod+C" = "spawn umbriel msg window-center && umbriel msg column-center"
"Mod+Shift+H" = "spawn ~/.local/bin/umbriel-move-window left"
"Mod+Shift+J" = "spawn ~/.local/bin/umbriel-move-window down"
"Mod+Shift+K" = "spawn ~/.local/bin/umbriel-move-window up"
"Mod+Shift+L" = "spawn ~/.local/bin/umbriel-move-window right"
"Mod+Ctrl+Shift+H" = "spawn ~/.local/bin/umbriel-move-window large-left"
"Mod+Ctrl+Shift+J" = "spawn ~/.local/bin/umbriel-move-window large-down"
"Mod+Ctrl+Shift+K" = "spawn ~/.local/bin/umbriel-move-window large-up"
"Mod+Ctrl+Shift+L" = "spawn ~/.local/bin/umbriel-move-window large-right"

# Window state and layout
"Mod+Space" = { action = "window-focus-switch-floating", repeat = false }
"Mod+Shift+Space" = { action = "window-toggle-floating", repeat = false }
"Mod+T" = { action = "window-toggle-pinned", repeat = false }
"Mod+M" = { action = "spawn ~/.local/bin/umbriel-maximize", repeat = false }
"Mod+F" = { action = "window-toggle-fullscreen", repeat = false }
"Mod+Ctrl+F" = { action = "window-toggle-maximize", repeat = false }
"Mod+R" = "window-cycle-primary-extent"
"Mod+Shift+R" = "window-cycle-primary-extent-back"
"Mod+Ctrl+H" = "window-modify-primary-extent -0.1"
"Mod+Ctrl+L" = "window-modify-primary-extent 0.1"
"Mod+Ctrl+J" = "window-modify-secondary-extent -0.1"
"Mod+Ctrl+K" = "window-modify-secondary-extent 0.1"
"Mod+Comma" = "window-consume-left"
"Mod+Period" = "window-consume-right"
"Mod+Ctrl+Comma" = "window-consume-from-left"
"Mod+Ctrl+Period" = "window-consume-from-right"
# Needs layout.mode = "dwindle".
# "Mod+Alt+T" = "layout-toggle-split"
"Mod+W" = { action = "column-toggle-tabbed", repeat = false }
"Mod+Alt+Right" = "column-focus-tab-next"
"Mod+Alt+Left" = "column-focus-tab-previous"
"Mod+O" = { action = "overview-toggle", repeat = false }
"Mod+Ctrl+MouseMiddle" = { action = "overview-toggle", repeat = false }

# Workspaces
# Move the whole workspace, retaining its name, layout, and windows.
# "Mod+Ctrl+Page_Down" = "workspace-move-to-output-next"
# "Mod+Ctrl+Page_Up" = "workspace-move-to-output-previous"
# "Mod+Ctrl+W" = "workspace-move-to-output current WEB --output your-output"

"Mod+X" = "output-focus-previous"
"Mod+Shift+X" = "window-move-to-output-previous"
"Mod+Ctrl+X" = "spawn umbriel msg window-move-to-output-previous && umbriel msg output-focus-previous"

"Mod+1" = "workspace-switch 1"
"Mod+2" = "workspace-switch 2"
"Mod+3" = "workspace-switch 3"
"Mod+4" = "workspace-switch 4"
"Mod+5" = "workspace-switch 5"
"Mod+6" = "workspace-switch 6"
"Mod+7" = "workspace-switch 7"
"Mod+8" = "workspace-switch 8"
"Mod+9" = "workspace-switch 9"
"Mod+WheelUp" = "workspace-previous"
"Mod+WheelDown" = "workspace-next"
"Mod+Shift+1" = "window-move-to-workspace 1"
"Mod+Shift+2" = "window-move-to-workspace 2"
"Mod+Shift+3" = "window-move-to-workspace 3"
"Mod+Shift+4" = "window-move-to-workspace 4"
"Mod+Shift+5" = "window-move-to-workspace 5"
"Mod+Shift+6" = "window-move-to-workspace 6"
"Mod+Shift+7" = "window-move-to-workspace 7"
"Mod+Shift+8" = "window-move-to-workspace 8"
"Mod+Shift+9" = "window-move-to-workspace 9"
"Mod+Ctrl+1" = "spawn umbriel msg window-move-to-workspace 1 && umbriel msg workspace-focus-last"
"Mod+Ctrl+2" = "spawn umbriel msg window-move-to-workspace 2 && umbriel msg workspace-focus-last"
"Mod+Ctrl+3" = "spawn umbriel msg window-move-to-workspace 3 && umbriel msg workspace-focus-last"
"Mod+Ctrl+4" = "spawn umbriel msg window-move-to-workspace 4 && umbriel msg workspace-focus-last"
"Mod+Ctrl+5" = "spawn umbriel msg window-move-to-workspace 5 && umbriel msg workspace-focus-last"
"Mod+Ctrl+6" = "spawn umbriel msg window-move-to-workspace 6 && umbriel msg workspace-focus-last"
"Mod+Ctrl+7" = "spawn umbriel msg window-move-to-workspace 7 && umbriel msg workspace-focus-last"
"Mod+Ctrl+8" = "spawn umbriel msg window-move-to-workspace 8 && umbriel msg workspace-focus-last"
"Mod+Ctrl+9" = "spawn umbriel msg window-move-to-workspace 9 && umbriel msg workspace-focus-last"
# Next available workspace: the first empty one on the focused output, or a new
# one after the last. Switching is skipped when already there, since
# back_and_forth would otherwise jump to the previous workspace.
"Mod+I" = { action = '''spawn ws=$(umbriel workspaces --json | jq -r '(map(select(.focused))[0]) as $c | map(select(.output == $c.output)) | ((map(select(.occupied | not))[0].index) // ((map(.index) | max) + 1)) | select(. != $c.index)') && [ -n "$ws" ] && umbriel msg workspace-switch "$ws"''', repeat = false }
"Mod+Shift+I" = { action = '''spawn ws=$(umbriel workspaces --json | jq -r '(map(select(.focused))[0]) as $c | map(select(.output == $c.output)) | ((map(select(.occupied | not))[0].index) // ((map(.index) | max) + 1)) | select(. != $c.index)') && [ -n "$ws" ] && umbriel msg window-move-to-workspace "$ws"''', repeat = false }
"Mod+Ctrl+I" = { action = '''spawn ws=$(umbriel workspaces --json | jq -r '(map(select(.focused))[0]) as $c | map(select(.output == $c.output)) | ((map(select(.occupied | not))[0].index) // ((map(.index) | max) + 1)) | select(. != $c.index)') && [ -n "$ws" ] && umbriel msg window-move-to-workspace "$ws" && umbriel msg workspace-focus-last''', repeat = false }

# Scratchpad
#"Mod+Shift+T" = { action = "window-move-to-scratchpad", repeat = false }
#"Mod+T" = "scratchpad-toggle"
#"Mod+Ctrl+T" = { action = "window-restore-from-scratchpad", repeat = false }
# Focus the next visible scratchpad window without hiding it. The built-in
# scratchpad-focus-next needs a scratchpad name once named scratchpads exist,
# so pick the window from any of them.
"Mod+Tab" = { action = '''spawn id=$(umbriel windows --json | jq -r '[.[] | select(.scratchpad != "" and .visible)] as $w | if ($w | length) == 0 then empty else $w[((($w | map(.active) | index(true)) // -1) + 1) % ($w | length)].id end') && [ -n "$id" ] && umbriel msg window-focus "$id"''', repeat = false }
"Mod+Alt+1" = "scratchpad-toggle 'Yazi Scratchpad'"
"Mod+Alt+2" = "scratchpad-toggle 'Neovim Scratchpad'"
"Mod+Alt+3" = "scratchpad-toggle 'Alacritty Scratchpad'"

# ==============================================================================
# Layout
# New scrolling-layout windows start at half the output width. Without this
# setting, each application chooses its starting width. Stacked columns retain
# their most recently focused row when focus leaves and later returns.
# https://docs.noctalia.dev/umbriel/layout/
[workspaces]
back_and_forth = true

[layout]
# mode = "scrolling" # "scrolling", "dwindle", "master", or "stacking".
extent_presets = [0.333, 0.5, 0.667]

# What a tiled window's own maximize button does: "column" fills the column,
# "edges" fills the usable area without struts, gaps, or borders. The
# window-toggle-maximize action is unaffected.
# client_maximize = "column"

[layout.stacking]
# drop_zones = false # Disable edge and corner drop zones when dragging in the stacking layout.

[layout.scrolling]
default_extent_fraction = 0.5
# Center the window picked in the overview, as column-center would.
# center_on_overview_select = true


# A tab group shows one window at a time below a bar of titles, and stacks and
# resizes like any row of its column. Mod+W tabs the focused window with the
# windows stacked beside it; Mod+Shift+J/K move a tab out of its group or a
# window into one. Click, scroll, or drag a title to switch, reorder, or pull it
# out.
# [layout.tabs]
# default_display = "normal"
# new_tab_position = "after_active"
# middle_click_closes = true
#
# [appearance.tab_bar]
# style = "titles"         # "indicator" draws thin slots without titles
# height = 24
# gap = -1                 # space between bar and window; -1 follows layout.gap
# font = "sans 10"
# visible = true           # false hides every bar; tabs keep working
# hide_when_single = false
# max_tabs = 6            # show at most 6 slots; more tabs scroll
# overflow = "scroll"      # or "shrink" to fit every tab

# ==============================================================================
# Window rules
# Rules combine in order, with later values overriding earlier ones.
# https://docs.noctalia.dev/umbriel/window-rules/

# Blur windows over the cached wallpaper blur. Set blur_optimized = false to
# include overlapping windows behind them, at a GPU cost on every frame that
# moves anything behind them.
[[window_rule]]
blur = true

# Fractions of the output's usable area, so the settings window also fits the
# resizable Sunshine output; 1020x900 on a 1920x1080 output.
[[window_rule]]
match.app_id = "^dev.noctalia.Noctalia$"
default_floating = true
default_floating_size = { width = 0.5313, height = 0.8604 }

[[window_rule]]
match.app_id = "^dev.noctalia.UmbrielSharePicker$"
default_floating = true
default_floating_size = { width = 0.4167, height = 0.5736 } # 800x600 on 1920x1080

[[window_rule]]
match.title = "^(Picture-in-Picture|Picture in picture)$"
default_floating = true
default_maximize = false
default_position = { x = 20, y = 20, anchor = "bottom_right" }

[[window_rule]]
match.title = "^notificationtoasts_.+_desktop"
default_focused = false
default_pinned = true
default_position = { x = 0, y = 0, anchor = "bottom_right" }

# Keep game menus inside their window; a focus or workspace keybind releases the pointer.
# [[window_rule]]
# match.app_id = "^steam_app_.*$"
# confine_pointer = true

# Keep compositor shortcuts available while a virtual machine window is focused.
# [[window_rule]]
# match.app_id = "^virt-manager$"
# allow_shortcuts_inhibit = false

# Keep an application drawing while it is hidden on another workspace, for programs whose other work stalls without it.
# [[window_rule]]
# match.app_id = "^obs$"
# background_render = true

# Keep matching windows visible locally but absent from screenshots and recordings.
# See docs/user/window-rules.md#capture-protection.
[[window_rule]]
match.app_id = "^org.kde.kdeconnect"
block_capture = true

# Keep one application's modal dialogs as ordinary windows.
# [[window_rule]]
# match.app_id = "^gimp"
# match.is_dialog = true
# attach_to_parent = false


[[window_rule]]
match.app_id = "^wev$"
default_scrolling_extent = 0.137 # 250 px

[[window_rule]]
match.app_id = "^virt-manager$"
match.title = "^Virtual Machine Manager$"
default_scrolling_extent = 0.171 # 315 px

[[window_rule]]
match.title = ["^File chooser$", "^File view$"]
attach_to_parent = false
default_floating = true
default_floating_size = { width = 0.5521, height = 0.956 } # 1060x1000 on 1920x1080
default_position = { x = 0, y = 20, anchor = "top" }

# Cisco Packet Tracer: float every window (device config windows)
[[window_rule]]
match.app_id = "^PacketTracer$"
default_floating = true

[[window_rule]]
match.app_id = "^PacketTracer$"
match.title = "^Cisco Packet Tracer"
default_floating = false

[[window_rule]]
match.app_id = "Scratchpad$"
default_floating_size = { width = 0.4917, height = 0.9809 }
[[scratchpad]]
name = "Yazi Scratchpad"
spawn_when_empty = "kitty --class YaziScratchpad yazi"
[[scratchpad]]
name = "Neovim Scratchpad"
spawn_when_empty = "kitty --class NeovimScratchpad nvim"
[[scratchpad]]
name = "Alacritty Scratchpad"
spawn_when_empty = "alacritty --class AlacrittyScratchpad"
# name = "music"
# spawn_when_empty = "spotify"

[animation.scratchpad]
dim = 0.7

# [[window_rule]]
# match.app_id = "^spotify$"
# default_scratchpad = "music"

# Give scratchpad windows their own border colors.
# [[window_rule]]
# match.is_scratchpad = true
# border_color_focused = "#E5C07BFF"
# border_color_unfocused = "#5C4A2AFF"

# Hide enabled title bars only while a window is maximized to edges.
# [[window_rule]]
# match.is_maximized_to_edges = true
# title_bar = "off"

# Frame the window being screencast; viewers never see the frame.
# [[window_rule]]
# match.is_cast_target = true
# border_color_focused = "#40C057FF"
# border_color_unfocused = "#40C057FF"

# Leave an application that draws its own corners and shadow undecorated.
# [[window_rule]]
# match.app_id = "^org[.]gnome[.]TextEditor$"
# border_width = 0
# corner_radius = 0
# shadow = false

# ==============================================================================
# Layer rules
# https://docs.noctalia.dev/umbriel/layer-rules/
[[layer_rule]]
match.namespace = "^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|desktop-widget-[^\"]*)$"
blur = true
blur_ignore_alpha = 0.5
blur_popups = true

# Panels, the dock, notifications and OSDs open over windows, so they blur the
# live content behind them. The bar and desktop widgets sit on the wallpaper and
# keep the cached wallpaper blur.
[[layer_rule]]
match.namespace = "^noctalia-(notification|dock|panel|attached-panel|osd)$"
blur_optimized = false

# ==============================================================================
# Overview
# Built-in overview and animation values are used. The top-left hot corner opens
# the overview after a short delay.
# Overview: https://docs.noctalia.dev/umbriel/workspaces-overview/
# Animation: https://docs.noctalia.dev/umbriel/animation/

[overview]
zoom = 0.33
workspace_wallpaper = false

[hot_corners.bottom_left]
enabled = true
delay_ms = 500
action = "overview-open"

# Window-rule opacity and blur fade on focus changes by default. Disable this
# independently of border fades, or choose its own duration and curve.
# [animation.windows_opacity]
# enabled = true
# curve = "spring:1,900"
# duration_ms = 250 # For non-spring curves; a spring sets its own length.

# Optional live workspace reveal (see docs/user/animation.md).
