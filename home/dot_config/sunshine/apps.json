{
    "apps": [
        {
            "auto-detach": true,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "desktop.png",
            "name": "Desktop",
            "prep-cmd": [
                {
                    "do": "python3 -c \"import os, subprocess, time; subprocess.run(['umbriel', 'msg', 'output-enable', 'HDMI-A-1']); time.sleep(0.5); scale = 3840 / int(os.environ['SUNSHINE_CLIENT_WIDTH']); subprocess.run(['wlr-randr', '--output', 'HDMI-A-1', '--scale', str(scale)])\"",
                    "undo": "umbriel msg output-enable DP-1"
                },
                {
                    "do": "umbriel msg output-disable DP-1",
                    "undo": "umbriel msg output-enable DP-3"
                },
                {
                    "do": "umbriel msg output-disable DP-3",
                    "undo": "umbriel msg output-disable HDMI-A-1"
                }
            ],
            "wait-all": true
        },
        {
            "auto-detach": true,
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "",
            "name": "Low Res Desktop (Not work)",
            "wait-all": true
        },
        {
            "auto-detach": true,
            "detached": [
                "setsid steam steam://open/bigpicture"
            ],
            "exclude-global-prep-cmd": false,
            "exit-timeout": 5,
            "image-path": "steam.png",
            "name": "Steam Big Picture",
            "prep-cmd": [
                {
                    "do": "python3 -c \"import os, subprocess, time; subprocess.run(['umbriel', 'msg', 'output-enable', 'HDMI-A-1']); time.sleep(0.5); scale = 3840 / int(os.environ['SUNSHINE_CLIENT_WIDTH']); subprocess.run(['wlr-randr', '--output', 'HDMI-A-1', '--scale', str(scale)])\"",
                    "undo": "umbriel msg output-enable DP-1"
                },
                {
                    "do": "umbriel msg output-disable DP-1",
                    "undo": "umbriel msg output-enable DP-3"
                },
                {
                    "do": "umbriel msg output-disable DP-3",
                    "undo": "umbriel msg output-disable HDMI-A-1"
                },
                {
                    "do": "",
                    "undo": "setsid steam steam://close/bigpicture"
                }
            ],
            "wait-all": true
        }
    ],
    "env": {
        "PATH": "$(PATH):$(HOME)/.local/bin"
    }
}
