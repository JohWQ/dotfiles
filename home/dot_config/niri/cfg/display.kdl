// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// You will have to remove "/-" and edit it before it takes effect.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

output "DP-2" {
    mode "1920x1080@143.999" // Set resolution and refresh rate
    position x=0 y=0
    scale 1 // No scaling (use 2 for HiDPI)
}

output "DP-3" {
    mode "1920x1080@144.000" // Set resolution and refresh rate
    transform "270"
    position x=1920 y=-374
    scale 1 // No scaling (use 2 for HiDPI)

    // Monitor specific workspace options
    layout {
        default-column-width { proportion 1.0; }
    }
}

output "HDMI-A-1" {
    off
}

// https://github.com/argosnothing/niri-scratchpad-rs
workspace "stash" { }
