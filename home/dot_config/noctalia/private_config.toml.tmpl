{{- /* Repository-backed settings for the Umbriel session; host overrides selected by hostname. No runtime state dependency. */ -}}
{{- $shared := `config_version = 20

[bar.default]
background_opacity = 0.79999998211860657
capsule_thickness = 1.0
center = [ "media" ]
end = [
  "clock",
  "tray",
  "phone-connect",
  "calculator",
  "recorder",
  "weather",
  "notifications",
  "volume",
  "shelly",
  "group:g1"
]
concave_edge_corners = false
margin_edge = 2
margin_ends = 20
radius = 20
radius_bottom_left = 20
radius_bottom_right = 20
radius_top_left = 20
radius_top_right = 20
start = [ "umbriel-companion", "workspaces", "focus-column-left", "focus-column-right", "active_window" ]
thickness = 32

[bar.default.dead_zone.actions]
left = "panel-toggle control-center home"
middle = "exec noctalia msg settings-open"
right = "panel-toggle session"

[[bar.default.capsule_group]]
accordion = true
accordion_delay_ms = 500
accordion_direction = "start"
border_width = 1.0
enabled = true
fill = "surface_container"
id = "g1"
members = [ "screenshot", "default-apps", "keyviz", "syncthing", "wallpaper", "select-ocr" ]
opacity = 1.0
padding = 6.0

[calendar]
enabled = true

[calendar.account.personal_google]
color = "primary"
name = "Personlig kalender"
type = "google"

[[control_center.shortcuts]]
type = "nightlight"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "caffeine"

[[control_center.shortcuts]]
type = "clipboard"

[[control_center.shortcuts]]
type = "noctalia/screen_recorder:toggle"

[desktop_widgets]
enabled = false

[dock]
active_opacity = 0.84999998100101948
active_scale = 0.85000001266598701
background_opacity = 0.4999999888241291
concave_edge_corners = false
enabled = true
inactive_opacity = 0.59999998658895493
launcher_position = "start"
magnification_scale = 1.2500000037252903
margin_edge = 2
pinned = [ "firefox" ]
radius = 20
reserve_space = false
show_dots = true
show_instance_count = false
smart_auto_hide = true

[hot_corners]
delay_ms = 400
enabled = true

[hot_corners.top_left]
action = "launcher"

[idle]
behavior_order = [ "lock", "screen-off", "lock-and-suspend" ]
