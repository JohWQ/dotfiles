[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 600.0

[idle.behavior.lock-and-suspend]
action = "lock_and_suspend"
enabled = false
timeout = 900.0

[idle.behavior.screen-off]
action = "screen_off"
enabled = false
timeout = 660.0

[keybinds]
cancel = [ "Escape" ]
copy = [ "Ctrl+c" ]
down = [ "Down", "Ctrl+j" ]
left = [ "Left", "Ctrl+h" ]
right = [ "Right", "Ctrl+l" ]
up = [ "Up", "Ctrl+k" ]
validate = [ "Return", "KP_Enter", "space", "Alt+e" ]

[lockscreen]
blur_intensity = 0.59999998658895493
tint_intensity = 0.69999998435378075
transition_duration = 1300
lock_before_suspend = true

[lockscreen_widgets]
enabled = false

[nightlight]
enabled = true

[notification]
filter_order = [ "filter" ]
scale = 0.95000000670552254

[notification.filter.filter]
allow_permanent = true
allowed_urgencies = [ "critical" ]
bypass_dnd = false
enabled = true
match = "helium"
match_content = "^teams[.]cloud[.]microsoft(?:\\s|$)"
play_sound = false
save_history = false
show_toast = false

[plugin_settings."h-jangra/keyviz"]
enabled_by_default = false

[plugin_settings."icefish/phone-connect"]
battery_display = "percent"

[plugin_settings."noctalia/screen_recorder"]
copy_to_clipboard = true
hide_inactive = true
video_source = "focused"

[plugin_settings."noctalia/timer"]
alarm = true
panel_open_near_click = false
panel_position = "top_right"

[plugin_settings."noctalia/wallhaven"]
download_dir = "~/Pictures/Wallpapers/wallhaven"

[plugin_settings."noctalia/world_clock"]
highlight_working_hours = false

[plugin_settings."rylos/syncthing"]
notify_events = false

[plugins]
enabled = [
  "rylos/syncthing",
  "joshuaslate/shelly",
  "yuuto/calculator",
  "h-jangra/keyviz",
  "icefish/phone-connect",
  "thepunkoff/pomodoro",
  "noctalia/screen_recorder",
  "noctalia/timer",
  "noctalia/wallhaven",
  "thaer99ob/default-apps",
  "noctalia/world_clock",
  "noctalia/umbriel-companion"
]

[shell]
avatar_path = "~/Pictures/.avatar.jpg"
clipboard_auto_paste = "off"
clipboard_history_max_entries = 300
clipboard_image_action_command = "noctalia msg annotate {path}"
polkit_agent = true
settings_expand_all_groups = true
show_location = false

[shell.launcher]
app_grid = true
auto_paste = "auto"
category_icons_only = true
layout = "simple"
show_app_actions = false
show_navigation_labels = false
show_session_button = false
show_settings_button = false

[shell.mpris]
blacklist = [ "losslesscut", "firefox" ]

[shell.privacy]
mic_filter_regex = "wiremix"

[shell.screenshot]
annotate = true
close_on_copy = true
copy_on_close = false

[[shell.session.actions]]
action = "lock"
countdown_seconds = 0.0
enabled = true
shortcut = "1"
variant = "default"

[[shell.session.actions]]
action = "logout"
countdown_seconds = 0.0
enabled = true
shortcut = "2"
variant = "default"

[[shell.session.actions]]
action = "suspend"
command = "if systemctl --user is-active --quiet app-dev.lizardbyte.app.Sunshine.service; then systemctl --user stop app-dev.lizardbyte.app.Sunshine.service && sleep 5; fi; systemctl suspend"
countdown_seconds = 0.0
enabled = false
glyph = "device-desktop-pause"
label = "Suspend"
variant = "outline"

[[shell.session.actions]]
action = "lock_and_suspend"
countdown_seconds = 0.0
enabled = true
shortcut = "3"
variant = "default"

[[shell.session.actions]]
action = "command"
command = "if systemctl --user is-active --quiet app-dev.lizardbyte.app.Sunshine.service; then systemctl --user stop app-dev.lizardbyte.app.Sunshine.service && sleep 5; fi; noctalia msg session lock-and-suspend"
countdown_seconds = 0.0
enabled = false
glyph = "player-pause"
label = "Lock & Suspend"
shortcut = "3"
variant = "default"

[[shell.session.actions]]
action = "reboot"
countdown_seconds = 0.0
enabled = true
shortcut = "4"
variant = "destructive"

[[shell.session.actions]]
action = "shutdown"
countdown_seconds = 0.0
enabled = true
shortcut = "5"
variant = "destructive"

[[shell.session.actions]]
action = "reboot_uefi"
countdown_seconds = 0.0
enabled = true
variant = "ghost"

[shell.window_switcher]
current_workspace_only = true
show_all_outputs = false
show_count = true

[theme]
builtin = "Catppuccin"
mode = "dark"
source = "builtin"

[theme.templates]
builtin_ids = [ "alacritty", "gtk3", "gtk4", "kitty" ]

[wallpaper]
directory = "~/Pictures/Wallpapers"

[widget.active_window]
max_length = 310

[widget.active_window.actions]
back = "exec umbriel msg window-modify-primary-extent -0.1"
forward = "exec umbriel msg window-modify-primary-extent +0.1"
left = "exec umbriel msg window-toggle-floating"
right = "exec appid=$(umbriel focused-window --json | jq -r '.app_id // \"window\"'); [ \"$(printf \"Cancel\\nYes\\n\" | noctalia dmenu -p \"Do you want to close $appid?\")\" = \"Yes\" ] && umbriel msg window-close"
scroll_down = "exec umbriel msg window-modify-secondary-extent -0.1"
scroll_up = "exec umbriel msg window-modify-secondary-extent +0.1"

[widget.active_window2]
max_length = 160
type = "active_window"

[widget.active_window2.actions]
back = "exec umbriel msg window-modify-primary-extent -0.1"
forward = "exec umbriel msg window-modify-primary-extent +0.1"
left = "exec umbriel msg window-toggle-floating"
right = "exec appid=$(umbriel focused-window --json | jq -r '.app_id // \"window\"'); [ \"$(printf \"Cancel\\nYes\\n\" | noctalia dmenu -p \"Do you want to close $appid?\")\" = \"Yes\" ] && umbriel msg window-close"
scroll_down = "exec umbriel msg window-modify-secondary-extent -0.1"
scroll_up = "exec umbriel msg window-modify-secondary-extent +0.1"

[widget.calculator]
type = "yuuto/calculator:bar"

[widget.clipboard]
enabled = false

[widget.clock]
format = "{:%H:%M | %d}"
tooltip_format = "{:%-I:%M %p} | {:%A} {:%d.%m.%y}"

[widget.clock.actions]
back = "exec noctalia msg panel-toggle noctalia/timer:panel"
forward = "exec noctalia msg panel-toggle noctalia/timer:panel"
right = "panel-toggle thepunkoff/pomodoro:panel"
scroll_down = "exec noctalia msg panel-toggle noctalia/world_clock:panel"

[widget.control-center]
enabled = false

[widget.control-center.actions]
right = "settings-open"

[widget.default-apps]
type = "thaer99ob/default-apps:current"

[widget.focus-column-left]
glyph = "arrow-big-left"
tooltip = "Focus Column to the Left"
type = "custom_button"

[widget.focus-column-left.actions]
left = "exec umbriel msg window-focus-left && umbriel msg column-center"
back = "exec umbriel msg window-focus-left && umbriel msg column-center"
forward = "exec umbriel msg window-focus-right && umbriel msg column-center"
scroll_down = "workspace-switch next"
scroll_up = "workspace-switch prev"

[widget.focus-column-right]
glyph = "arrow-big-right"
tooltip = "Focus Column to the Right"
type = "custom_button"

[widget.focus-column-right.actions]
left = "exec umbriel msg window-focus-right && umbriel msg column-center"
back = "exec umbriel msg window-focus-left && umbriel msg column-center"
forward = "exec umbriel msg window-focus-right && umbriel msg column-center"
scroll_down = "workspace-switch next"
scroll_up = "workspace-switch prev"

[widget.keyviz]
type = "h-jangra/keyviz:widget"

[widget.media]
hide_when_no_media = true
max_length = 440
show_progress = true
title_scroll = "on_hover"

[widget.media.actions]
scroll_down = "exec playerctl volume 0.02-"
scroll_up = "exec playerctl volume 0.02+"

[widget.media2]
hide_when_no_media = true
max_length = 200
show_progress = true
title_scroll = "on_hover"
type = "media"

[widget.media2.actions]
scroll_down = "exec playerctl volume 0.02-"
scroll_up = "exec playerctl volume 0.02+"

[widget.network]
enabled = false
show_label = false

[widget.phone-connect]
type = "icefish/phone-connect:bar"

[widget.recorder]
type = "noctalia/screen_recorder:recorder"

[widget.select-ocr]
glyph = "text-recognition"
type = "custom_button"

[widget.select-ocr.actions]
left = "exec ~/.local/bin/screen-ocr.sh"

[widget.session]
enabled = false

[widget.shelly]
bar_label = "count_only"
click_action = "open_updater"
hide_when_up_to_date = true
type = "joshuaslate/shelly:shelly"

[widget.syncthing]
type = "rylos/syncthing:bar"

[widget.tray]
drawer = false

[widget.tray2]
drawer = true
type = "tray"

[widget.volume.actions]
back = "volume-down 1"
forward = "volume-up 1"

[widget.umbriel-companion]
type = "noctalia/umbriel-companion:bar"

[widget.wallpaper.actions]
right = "panel-toggle noctalia/wallhaven:browser"

[widget.weather]
show_condition = false

[widget.workspaces]
active_pill_size = 2.8000000000000003
focused_output_only = true
labels_only_when_occupied = true

[widget.workspaces.actions]
back = "exec umbriel msg window-focus-left && umbriel msg column-center"
forward = "exec umbriel msg window-focus-right && umbriel msg column-center"
right = "exec umbriel msg overview-toggle"
` | fromToml -}}
{{- $hostPath := joinPath .chezmoi.sourceDir ".chezmoitemplates/noctalia/hosts" .chezmoi.hostname -}}
{{- $machine := dict -}}
{{- $secrets := dict -}}
{{- if stat (printf "%s.toml" $hostPath) -}}
{{- $machine = include (printf "%s.toml" $hostPath) | fromToml -}}
{{- end -}}
{{- if stat (printf "%s.age" $hostPath) -}}
{{- $secrets = include (printf "%s.age" $hostPath) | decrypt | fromToml -}}
{{- end -}}
{{- $config := mergeOverwrite $shared $machine $secrets -}}
{{- /* Shared login-box defaults apply to every host's monitor-specific widgets. */ -}}
{{- range $widget := (get $config.lockscreen_widgets "widget" | default dict) -}}
{{- if eq $widget.type "login_box" -}}
{{- $_ := set $widget "settings" (mergeOverwrite (dict "show_media" false "show_password_reveal" true) ($widget.settings | default dict)) -}}
{{- end -}}
{{- end -}}
{{ $config | toToml }}
