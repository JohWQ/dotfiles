{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Run after system packages install yay, and rerun when the AUR list changes.
# aur-package-list-sha256: {{ include "../package-lists/arch-aur-pkglist.txt" | sha256sum }}

[[ -r /etc/os-release ]] || exit 0
. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
    *" arch "*|*" cachyos "*) ;;
    *) exit 0 ;;
esac

package_list={{ joinPath .chezmoi.sourceDir ".." "package-lists" "arch-aur-pkglist.txt" | shellQuote }}
packages=()
while IFS= read -r line || [[ -n "$line" ]]; do
    # Accept one package per line, with optional whitespace and # comments.
    read -r package extra <<< "${line%%#*}"
    [[ -n "$package" ]] || continue
    if [[ -n "$extra" || ! "$package" =~ ^[a-zA-Z0-9@_+][a-zA-Z0-9@._+:-]*$ ]]; then
        printf 'Invalid package-list entry: %s\n' "$line" >&2
        exit 1
    fi
    packages+=("$package")
done < "$package_list"

(( ${#packages[@]} > 0 )) || exit 0
if (( EUID == 0 )); then
    echo 'AUR package installation must run as a regular user.' >&2
    exit 1
fi
command -v yay >/dev/null || { echo 'AUR package installation requires yay.' >&2; exit 1; }

yay -S --needed -- "${packages[@]}"
{{ end -}}
