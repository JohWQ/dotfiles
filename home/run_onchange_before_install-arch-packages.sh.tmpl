{{- if eq .chezmoi.os "linux" }}
#!/bin/bash
set -euo pipefail

# Changing the package list makes chezmoi run this script again.
# package-list-sha256: {{ include "../package-lists/arch-pkglist.txt" | sha256sum }}

[[ -r /etc/os-release ]] || exit 0
. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
    *" arch "*|*" cachyos "*) ;;
    *) exit 0 ;;
esac

package_list={{ joinPath .chezmoi.sourceDir ".." "package-lists" "arch-pkglist.txt" | shellQuote }}
packages=()
while IFS= read -r line || [[ -n "$line" ]]; do
    # Accept one package per line, with optional whitespace and # comments.
    read -r package extra <<< "${line%%#*}"
    [[ -n "$package" ]] || continue
    if [[ -n "$extra" || ! "$package" =~ ^[a-zA-Z0-9@_+][a-zA-Z0-9@._+:-]*$ ]]; then
        printf 'Invalid package-list entry: %s\n' "$line" >&2
        exit 1
    fi
    packages+=("$package")
done < "$package_list"

(( ${#packages[@]} > 0 )) || exit 0
command -v pacman >/dev/null || { echo 'Arch package installation requires pacman.' >&2; exit 1; }

if (( EUID == 0 )); then
    pacman -S --needed -- "${packages[@]}"
else
    sudo pacman -S --needed -- "${packages[@]}"
fi
{{ end -}}
