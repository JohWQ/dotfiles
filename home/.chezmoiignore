{{ if or (eq .chezmoi.os "windows") (eq (lower .chezmoi.hostname) "windows-desktop") -}}
# Windows is opt-in. Add explicit exceptions only for reviewed Windows targets.
# Also covers WSL when it reports the windows-desktop hostname.
**
{{ if and (eq .chezmoi.os "windows") (eq (lower .chezmoi.hostname) "windows-desktop") -}}
# Native windows-desktop uses separate application configs.
!AppData/
!AppData/Local/
!AppData/Local/nvim/
!AppData/Local/nvim/**
!AppData/Roaming/
!AppData/Roaming/yazi/
!AppData/Roaming/yazi/config/
!AppData/Roaming/yazi/config/**
!Documents/
!Documents/PowerShell/
!Documents/PowerShell/**
!Documents/WindowsPowerShell/
!Documents/WindowsPowerShell/**
!install-windows-yazi-packages.ps1
{{ end -}}
{{ if eq .chezmoi.os "windows" -}}
# Downloaded plugins are restored from package.toml; keep only our local plugin.
AppData/Roaming/yazi/config/plugins/**
!AppData/Roaming/yazi/config/plugins/confirm-quit.yazi/
!AppData/Roaming/yazi/config/plugins/confirm-quit.yazi/*.lua
AppData/Roaming/yazi/config/flavors/**
Documents/PowerShell/Modules/**
Documents/PowerShell/dot_zshrc
{{ end -}}

# Never capture nested repositories, credentials, or plugin runtime data.
**/.git
**/.env
**/pref-by-location
**/whoosh.yazi/bookmarks
{{ else -}}
**/.git
**/.env
# Windows application configs are independent of shared Linux configs.
AppData
Documents
install-windows-yazi-packages.ps1

# Keep laptop output settings separate from other hosts.
{{ if ne .chezmoi.hostname "cachyos-laptop" -}}
.config/niri/cfg/outputs.kdl
{{ end -}}

# Downloaded Yazi packages belong to `ya pkg`, not chezmoi.
# Git ignores them too, but old ignored source files can still exist locally.
**/pref-by-location
.config/yazi/plugins/**
!.config/yazi/plugins/
!.config/yazi/plugins/confirm-quit.yazi/
!.config/yazi/plugins/confirm-quit.yazi/**
.config/yazi/flavors/**

# Noctalia restores enabled plugins from the shared config's git sources.
.local/share/noctalia/plugins/**
.local/state/noctalia/**
{{ end -}}
