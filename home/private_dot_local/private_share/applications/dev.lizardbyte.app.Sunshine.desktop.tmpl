[Desktop Entry]
Actions=RunInTerminal;
Categories=RemoteAccess;Network;
Comment=Self-hosted game stream host for Moonlight
Exec=sh -c "noctalia msg caffeine-disable; exec systemctl --user start app-dev.lizardbyte.app.Sunshine.service"
Icon=dev.lizardbyte.app.Sunshine
StartupWMClass=dev.lizardbyte.app.Sunshine
Keywords=gamestream;stream;moonlight;remote play;
Name=Sunshine
Type=Application
Version=1.0

[Desktop Action RunInTerminal]
Exec=gio launch {{ joinPath .chezmoi.homeDir ".local/share/applications/dev.lizardbyte.app.Sunshine.terminal.desktop" | quote }}
Icon=application-x-executable
Name=Run in Terminal
