{{- if and (eq .chezmoi.os "windows") (eq (lower .chezmoi.hostname) "windows-desktop") -}}
# Rerun when the Windows Yazi package list changes.
# UniGetUI manages the Yazi application; chezmoi restores its plugins.
# yazi-package-list-sha256: {{ include "readonly_AppData/Roaming/yazi/config/package.toml" | sha256sum }}
$ErrorActionPreference = 'Stop'

if (-not (Get-Command ya -ErrorAction SilentlyContinue)) {
    throw 'Install Yazi through UniGetUI, open a new PowerShell session, then run chezmoi apply again.'
}

$env:YAZI_CONFIG_HOME = Join-Path $env:APPDATA 'yazi/config'

# `ya pkg install` aborts when a package differs from its pinned hash.
# --discard overwrites such packages; only offer it when someone can answer.
$installArgs = @()
if ([Environment]::UserInteractive -and -not [Console]::IsInputRedirected) {
    Write-Host 'Yazi: --discard overwrites packages that were edited in the Yazi plugins or flavors directory.'
    Write-Host 'Answer yes unless you have changed files there yourself.'
    if ((Read-Host 'Run "ya pkg install --discard"? [y/N]') -match '^(y|yes)$') {
        $installArgs += '--discard'
    }
}

& ya pkg install @installArgs
if ($LASTEXITCODE -ne 0) {
    throw "Yazi package installation failed with exit code $LASTEXITCODE."
}
{{ end -}}
