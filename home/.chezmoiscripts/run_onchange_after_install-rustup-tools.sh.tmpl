{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Run after install-rustup-packages, and rerun when the Cargo package list changes.
# cargo-package-list-sha256: {{ include "../package-lists/arch-cargo_binstall-pkglist.txt" | sha256sum }}

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
command -v cargo >/dev/null || exit 0
cargo binstall --version >/dev/null 2>&1 || exit 0

package_list={{ joinPath .chezmoi.sourceDir ".." "package-lists" "arch-cargo_binstall-pkglist.txt" | shellQuote }}
packages=()
while IFS= read -r line || [[ -n "$line" ]]; do
    # Accept one crate per line, with optional whitespace and # comments.
    read -r package extra <<< "${line%%#*}"
    [[ -n "$package" ]] || continue
    if [[ -n "$extra" || ! "$package" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_-]*$ ]]; then
        printf 'Invalid Cargo package-list entry: %s\n' "$line" >&2
        exit 1
    fi
    packages+=("$package")
done < "$package_list"

(( ${#packages[@]} > 0 )) || exit 0
cargo binstall --no-confirm -- "${packages[@]}"
{{ end -}}
