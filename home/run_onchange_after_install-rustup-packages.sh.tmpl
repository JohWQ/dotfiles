{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

# Rerun when the system package list changes.
# arch-package-list-sha256: {{ include "../package-lists/arch-pkglist.txt" | sha256sum }}

[[ -r /etc/os-release ]] || exit 0
. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
    *" arch "*|*" cachyos "*) ;;
    *) exit 0 ;;
esac

if ! command -v rustup >/dev/null && [[ ! -x "${CARGO_HOME:-$HOME/.cargo}/bin/rustup" ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
fi

export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
cargo install --git https://github.com/argosnothing/niri-scratchpad-rs.git --branch=hidden-workspaces
{{ end -}}
